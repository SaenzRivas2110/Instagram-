<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Instagram · Liquid Glass</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #000000;
      --bg-elevated: #0a0a0c;
      --surface: rgba(28, 28, 30, 0.55);
      --surface-2: rgba(44, 44, 46, 0.5);
      --surface-3: rgba(58, 58, 60, 0.45);
      --glass: rgba(255, 255, 255, 0.07);
      --glass-border: rgba(255, 255, 255, 0.12);
      --glass-highlight: rgba(255, 255, 255, 0.22);
      --text: #f5f5f7;
      --text-secondary: rgba(235, 235, 245, 0.62);
      --text-tertiary: rgba(235, 235, 245, 0.32);
      --accent: #0a84ff;
      --accent-glow: rgba(10, 132, 255, 0.4);
      --like: #ff375f;
      --like-glow: rgba(255, 55, 95, 0.45);
      --success: #30d158;
      --instagram: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
      --safe-top: env(safe-area-inset-top, 0px);
      --safe-bottom: env(safe-area-inset-bottom, 0px);
      --radius: 22px;
      --radius-sm: 16px;
      --radius-xs: 12px;
      --blur: 48px;
      --blur-strong: 72px;
      --spring: cubic-bezier(0.34, 1.45, 0.64, 1);
      --spring-soft: cubic-bezier(0.22, 1.2, 0.36, 1);
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      -webkit-font-smoothing: antialiased;
    }

    html, body {
      height: 100%;
      background: #050505;
      color: var(--text);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', system-ui, sans-serif;
      overflow: hidden;
      overscroll-behavior: none;
    }

    .app-shell {
      width: 100%;
      height: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      background: radial-gradient(ellipse at 50% 0%, #1a1a2e 0%, #050505 70%);
    }

    .phone {
      width: 100%;
      max-width: 430px;
      height: 100%;
      max-height: 932px;
      background: var(--bg);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow:
        0 0 0 1px rgba(255,255,255,0.05),
        0 0 0 10px #111,
        0 0 0 11px rgba(255,255,255,0.03),
        0 40px 100px rgba(0,0,0,0.7);
    }

    @media (min-width: 768px) {
      .app-shell {
        padding: 24px;
        background: 
          radial-gradient(ellipse at 30% 20%, rgba(10,132,255,0.08) 0%, transparent 50%),
          radial-gradient(ellipse at 70% 80%, rgba(255,55,95,0.06) 0%, transparent 50%),
          #050505;
      }
      .phone {
        border-radius: 48px;
        max-height: 90vh;
        height: 880px;
        box-shadow:
          0 0 0 1px rgba(255,255,255,0.07),
          0 0 0 14px #0c0c0e,
          0 0 0 15px rgba(255,255,255,0.04),
          0 50px 130px rgba(0,0,0,0.8);
      }
    }

    @media (min-width: 1200px) {
      .phone { max-width: 400px; }
    }

    /* ========== LIQUID GLASS ========== */
    .glass {
      background: var(--surface);
      backdrop-filter: blur(var(--blur)) saturate(180%) brightness(1.06);
      -webkit-backdrop-filter: blur(var(--blur)) saturate(180%) brightness(1.06);
      border: 1px solid var(--glass-border);
      box-shadow:
        inset 0 1px 0 0 var(--glass-highlight),
        0 8px 32px rgba(0,0,0,0.28);
    }

    .glass-strong {
      background: rgba(16, 16, 18, 0.78);
      backdrop-filter: blur(var(--blur-strong)) saturate(200%) brightness(1.1);
      -webkit-backdrop-filter: blur(var(--blur-strong)) saturate(200%) brightness(1.1);
      border: 1px solid rgba(255,255,255,0.1);
      box-shadow:
        inset 0 1px 0 0 rgba(255,255,255,0.14),
        0 12px 40px rgba(0,0,0,0.38);
    }

    .glass-nav {
      background: rgba(10, 10, 12, 0.72);
      backdrop-filter: blur(56px) saturate(190%);
      -webkit-backdrop-filter: blur(56px) saturate(190%);
      border-top: 1px solid rgba(255,255,255,0.08);
      box-shadow: 0 -10px 40px rgba(0,0,0,0.35);
    }

    .glass-card {
      background: linear-gradient(145deg, rgba(255,255,255,0.09) 0%, rgba(255,255,255,0.03) 100%);
      backdrop-filter: blur(40px) saturate(180%);
      -webkit-backdrop-filter: blur(40px) saturate(180%);
      border: 1px solid rgba(255,255,255,0.13);
      box-shadow:
        inset 0 1px 0 0 rgba(255,255,255,0.18),
        0 10px 36px rgba(0,0,0,0.3);
    }

    /* ========== STATUS BAR ========== */
    .status-bar {
      display: none;
      height: 0;
      padding: 0;
      overflow: hidden;
    }

    @media (min-width: 768px) {
      .status-bar {
        display: flex;
        height: 36px;
        padding: 0 22px;
        align-items: center;
        justify-content: space-between;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: -0.2px;
        z-index: 100;
        position: relative;
        flex-shrink: 0;
        color: rgba(255,255,255,0.75);
      }
      .status-icons {
        display: flex;
        gap: 6px;
        align-items: center;
      }
      .status-icons svg {
        width: 15px;
        height: 15px;
        opacity: 0.85;
      }
    }

    /* ========== HEADER ========== */
    .header {
      height: 54px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 16px;
      padding-top: env(safe-area-inset-top, 6px);
      position: relative;
      z-index: 50;
      flex-shrink: 0;
    }

    @media (min-width: 768px) {
      .header { padding-top: 0; }
    }

    .header-title {
      font-size: 24px;
      font-weight: 700;
      letter-spacing: -0.8px;
      background: linear-gradient(135deg, #fff 0%, #d8d8e0 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .header-title.logo {
      font-family: 'Inter', cursive;
      font-weight: 800;
      letter-spacing: -1.4px;
      font-size: 27px;
    }

    .header-actions {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .icon-btn {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: none;
      color: var(--text);
      cursor: pointer;
      transition: transform 0.28s var(--spring), background 0.2s;
      position: relative;
    }

    .icon-btn:active {
      transform: scale(0.84);
      background: var(--glass);
    }

    .icon-btn svg {
      width: 24px;
      height: 24px;
    }

    /* ========== CONTENT ========== */
    .content {
      flex: 1;
      overflow-y: auto;
      overflow-x: hidden;
      -webkit-overflow-scrolling: touch;
      scroll-behavior: smooth;
      padding-bottom: 110px;
      position: relative;
    }

    .content::-webkit-scrollbar { display: none; }

    /* ========== STORIES ========== */
    .stories-row {
      display: flex;
      gap: 16px;
      padding: 14px 18px 18px;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .stories-row::-webkit-scrollbar { display: none; }

    .story-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 7px;
      flex-shrink: 0;
      cursor: pointer;
      transition: transform 0.35s var(--spring);
    }

    .story-item:active { transform: scale(0.9); }

    .story-ring {
      width: 78px;
      height: 78px;
      border-radius: 50%;
      padding: 3px;
      background: var(--instagram);
      position: relative;
      box-shadow: 0 4px 18px rgba(220, 39, 67, 0.3);
      transition: transform 0.4s var(--spring), box-shadow 0.3s;
    }

    .story-item:hover .story-ring {
      transform: scale(1.06);
      box-shadow: 0 6px 26px rgba(220, 39, 67, 0.45);
    }

    .story-ring.seen {
      background: rgba(255,255,255,0.2);
      box-shadow: none;
    }

    .story-ring.own {
      background: linear-gradient(145deg, #5ac8fa, #0a84ff, #0071e3);
      box-shadow: 0 4px 20px rgba(10, 132, 255, 0.4);
    }

    .story-avatar {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      border: 3.5px solid #000;
      background: #1c1c1e;
      display: block;
    }

    .story-add {
      position: absolute;
      bottom: 1px;
      right: 1px;
      width: 24px;
      height: 24px;
      background: var(--accent);
      border-radius: 50%;
      border: 3px solid #000;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      font-weight: 600;
      line-height: 1;
      color: white;
      box-shadow: 0 2px 10px rgba(10, 132, 255, 0.55);
    }

    .story-name {
      font-size: 11.5px;
      color: var(--text-secondary);
      max-width: 80px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      text-align: center;
      font-weight: 450;
    }

    /* ========== PROFILE — estilo Instagram real + Liquid Glass ========== */
    .profile-header-bar {
      height: 52px;
      padding: 0 8px;
    }
    .header-left { display: flex; align-items: center; }
    .header-center {
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 1;
      gap: 2px;
    }
    .username-title {
      font-size: 18px !important;
      font-weight: 700 !important;
      letter-spacing: -0.4px !important;
      background: none !important;
      -webkit-text-fill-color: var(--text) !important;
      color: var(--text) !important;
    }
    .online-dot {
      width: 7px;
      height: 7px;
      background: var(--like);
      border-radius: 50%;
      margin-left: 4px;
      box-shadow: 0 0 8px var(--like-glow);
    }
    .threads-badge {
      top: 2px !important;
      right: 2px !important;
      min-width: 16px;
      height: 16px;
      font-size: 9px;
      background: var(--like);
    }

    .profile-section {
      padding: 8px 16px 12px;
      animation: slideUp 0.5s var(--ease-out) both;
    }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .profile-top-row {
      display: flex;
      align-items: center;
      gap: 18px;
      margin-bottom: 14px;
    }

    .profile-pic-wrap {
      position: relative;
      flex-shrink: 0;
    }

    .profile-pic {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid #000;
      background: #1c1c1e;
      display: block;
    }

    .profile-stats {
      display: flex;
      flex: 1;
      justify-content: space-around;
      text-align: center;
    }

    .stat {
      cursor: pointer;
      transition: transform 0.25s var(--spring), opacity 0.2s;
      padding: 6px 4px;
      border-radius: 10px;
    }

    .stat:active {
      transform: scale(0.92);
      opacity: 0.7;
    }

    .stat-num {
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    .stat-label {
      font-size: 12px;
      color: var(--text-secondary);
      margin-top: 2px;
      font-weight: 450;
    }

    .profile-info {
      margin-bottom: 12px;
    }

    .profile-name {
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 3px;
      letter-spacing: -0.2px;
      text-transform: uppercase;
    }

    .profile-bio {
      font-size: 14px;
      line-height: 1.4;
      color: var(--text);
      white-space: pre-line;
      font-weight: 400;
    }

    .profile-link {
      color: #e0f0ff;
      font-size: 13.5px;
      margin-top: 4px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-weight: 500;
      text-decoration: none;
    }
    .profile-link::before {
      content: '🔗';
      font-size: 12px;
    }

    .profile-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 4px;
    }

    .chip {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 6px 12px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.07);
      color: var(--text);
      font-size: 12.5px;
      font-weight: 520;
      cursor: pointer;
      transition: background 0.2s, transform 0.2s;
      backdrop-filter: blur(12px);
    }
    .chip:active {
      background: rgba(255,255,255,0.14);
      transform: scale(0.96);
    }
    .chip-add {
      color: var(--text-secondary);
    }

    .profile-actions {
      display: flex;
      gap: 8px;
      margin-top: 14px;
    }

    .btn {
      flex: 1;
      height: 40px;
      border-radius: 14px;
      border: none;
      font-size: 14px;
      font-weight: 620;
      cursor: pointer;
      transition: transform 0.28s var(--spring), opacity 0.2s, box-shadow 0.25s, background 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      letter-spacing: -0.2px;
    }

    .btn:active { transform: scale(0.95); }

    .btn-primary {
      background: var(--accent);
      color: white;
      box-shadow: 0 4px 18px var(--accent-glow);
    }

    .btn-secondary {
      background: rgba(255,255,255,0.1);
      color: var(--text);
      border: 1px solid rgba(255,255,255,0.14);
      backdrop-filter: blur(24px);
    }

    .btn-secondary:active {
      background: rgba(255,255,255,0.16);
    }

    .btn-icon {
      width: 40px;
      flex: 0 0 40px;
      padding: 0;
    }

    /* Highlights */
    .highlights {
      display: flex;
      gap: 18px;
      padding: 4px 18px 22px;
      overflow-x: auto;
      scrollbar-width: none;
      animation: slideUp 0.6s var(--ease-out) 0.08s both;
    }

    .highlights::-webkit-scrollbar { display: none; }

    .highlight {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
      cursor: pointer;
      transition: transform 0.3s var(--spring);
    }

    .highlight:active { transform: scale(0.9); }

    .highlight-ring {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      border: 1.6px solid rgba(255,255,255,0.22);
      padding: 3.5px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: border-color 0.25s, box-shadow 0.25s;
      background: rgba(255,255,255,0.04);
    }

    .highlight:hover .highlight-ring {
      border-color: rgba(255,255,255,0.4);
      box-shadow: 0 4px 18px rgba(255,255,255,0.1);
    }

    .highlight-img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      background: #1c1c1e;
    }

    .highlight-add {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: rgba(255,255,255,0.08);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      color: var(--text);
      font-weight: 300;
    }

    .highlight-name {
      font-size: 12px;
      color: var(--text);
      max-width: 74px;
      text-align: center;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-weight: 450;
    }

    /* Tabs */
    .profile-tabs {
      display: flex;
      border-top: 1px solid rgba(255,255,255,0.08);
      position: sticky;
      top: 0;
      z-index: 20;
      background: rgba(0,0,0,0.78);
      backdrop-filter: blur(32px) saturate(160%);
      -webkit-backdrop-filter: blur(32px) saturate(160%);
    }

    .tab {
      flex: 1;
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: none;
      background: transparent;
      color: var(--text-tertiary);
      cursor: pointer;
      position: relative;
      transition: color 0.25s;
    }

    .tab.active { color: var(--text); }

    .tab.active::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 24%;
      right: 24%;
      height: 1.6px;
      background: var(--text);
      border-radius: 1px;
      animation: tabIn 0.3s var(--spring);
    }

    @keyframes tabIn {
      from { transform: scaleX(0.35); opacity: 0; }
      to { transform: scaleX(1); opacity: 1; }
    }

    .tab svg {
      width: 24px;
      height: 24px;
      transition: transform 0.3s var(--spring);
    }

    .tab.active svg { transform: scale(1.1); }

    /* Grid */
    .posts-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2px;
      background: rgba(255,255,255,0.04);
      animation: fadeIn 0.5s var(--ease-out) 0.12s both;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .post-thumb {
      aspect-ratio: 1;
      position: relative;
      cursor: pointer;
      overflow: hidden;
      background: #111;
      animation: gridPop 0.5s var(--spring) both;
    }

    @keyframes gridPop {
      from { opacity: 0; transform: scale(0.88); }
      to { opacity: 1; transform: scale(1); }
    }

    .post-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s var(--ease-out);
    }

    .post-thumb:active img { transform: scale(1.07); }

    .post-thumb.is-video iframe {
      width: 100%;
      height: 100%;
      border: none;
      pointer-events: none;
      object-fit: cover;
    }

    .video-thumb {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 5;
      width: 46px;
      height: 46px;
      background: rgba(0,0,0,0.5);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(10px);
      border: 1.5px solid rgba(255,255,255,0.32);
      transition: transform 0.3s var(--spring);
    }

    .post-thumb:hover .video-thumb {
      transform: translate(-50%, -50%) scale(1.15);
    }

    .post-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 55%);
      display: flex;
      align-items: flex-end;
      justify-content: center;
      gap: 16px;
      opacity: 0;
      transition: opacity 0.3s;
      color: white;
      font-weight: 650;
      font-size: 13.5px;
      padding-bottom: 14px;
      pointer-events: none;
      z-index: 6;
    }

    .post-thumb:hover .post-overlay { opacity: 1; }

    .post-overlay span {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    /* ========== FEED ========== */
    .feed-post {
      margin-bottom: 10px;
      animation: postIn 0.5s var(--ease-out) both;
    }

    .feed-post:nth-child(1) { animation-delay: 0.04s; }
    .feed-post:nth-child(2) { animation-delay: 0.09s; }
    .feed-post:nth-child(3) { animation-delay: 0.14s; }
    .feed-post:nth-child(4) { animation-delay: 0.19s; }
    .feed-post:nth-child(5) { animation-delay: 0.24s; }

    @keyframes postIn {
      from { opacity: 0; transform: translateY(22px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .feed-header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
    }

    .feed-avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      object-fit: cover;
      border: 1.5px solid rgba(255,255,255,0.12);
    }

    .feed-user {
      flex: 1;
      font-size: 14.5px;
      font-weight: 650;
      letter-spacing: -0.2px;
    }

    .feed-img-wrap {
      width: 100%;
      aspect-ratio: 1;
      background: #0d0d0d;
      position: relative;
      overflow: hidden;
    }

    .feed-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .feed-actions {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 12px 14px 6px;
    }

    .feed-actions .icon-btn {
      width: 36px;
      height: 36px;
    }

    .feed-actions .icon-btn svg {
      width: 26px;
      height: 26px;
    }

    .feed-likes {
      padding: 2px 16px 0;
      font-size: 14px;
      font-weight: 650;
      letter-spacing: -0.15px;
    }

    .feed-caption {
      padding: 5px 16px 0;
      font-size: 14px;
      line-height: 1.42;
    }

    .feed-caption strong {
      font-weight: 650;
      margin-right: 6px;
    }

    .feed-time {
      padding: 7px 16px 16px;
      font-size: 11px;
      color: var(--text-tertiary);
      text-transform: uppercase;
      letter-spacing: 0.4px;
      font-weight: 500;
    }

    .heart-burst {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0);
      pointer-events: none;
      z-index: 10;
      filter: drop-shadow(0 4px 22px rgba(255,55,95,0.55));
    }

    .heart-burst.show {
      animation: heartPop 0.95s var(--spring) forwards;
    }

    @keyframes heartPop {
      0% { transform: translate(-50%, -50%) scale(0); opacity: 0; }
      12% { transform: translate(-50%, -50%) scale(1.4); opacity: 1; }
      28% { transform: translate(-50%, -50%) scale(0.9); }
      42% { transform: translate(-50%, -50%) scale(1.15); }
      70% { opacity: 1; }
      100% { transform: translate(-50%, -50%) scale(1.05); opacity: 0; }
    }

    /* ========== MESSAGES ========== */
    .messages-list { padding: 10px 0; }

    .msg-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 18px;
      cursor: pointer;
      transition: background 0.25s, transform 0.25s var(--spring);
      border-radius: 18px;
      margin: 0 10px;
    }

    .msg-item:active {
      background: var(--glass);
      transform: scale(0.98);
    }

    .msg-avatar {
      width: 62px;
      height: 62px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
      border: 2px solid rgba(255,255,255,0.1);
      box-shadow: 0 4px 16px rgba(0,0,0,0.32);
    }

    .msg-info { flex: 1; min-width: 0; }

    .msg-top {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 4px;
    }

    .msg-name {
      font-size: 16px;
      font-weight: 650;
      letter-spacing: -0.2px;
    }

    .msg-time {
      font-size: 12.5px;
      color: var(--text-secondary);
      font-weight: 450;
    }

    .msg-preview {
      font-size: 14.5px;
      color: var(--text-secondary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-weight: 400;
    }

    .msg-preview.unread {
      color: var(--text);
      font-weight: 550;
    }

    .msg-dot {
      width: 9px;
      height: 9px;
      background: var(--accent);
      border-radius: 50%;
      flex-shrink: 0;
      box-shadow: 0 0 12px var(--accent-glow);
      animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.65; transform: scale(0.88); }
    }

    /* ========== CHAT ========== */
    .chat-header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 8px 14px;
      height: 60px;
      flex-shrink: 0;
    }

    .chat-back {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: none;
      background: transparent;
      color: var(--text);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: transform 0.25s var(--spring), background 0.2s;
    }

    .chat-back:active {
      transform: scale(0.86);
      background: var(--glass);
    }

    .chat-user-info {
      display: flex;
      align-items: center;
      gap: 12px;
      flex: 1;
    }

    .chat-avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      object-fit: cover;
      border: 1.5px solid rgba(255,255,255,0.12);
    }

    .chat-name {
      font-size: 15.5px;
      font-weight: 650;
      letter-spacing: -0.2px;
    }

    .chat-status {
      font-size: 12px;
      color: var(--success);
      font-weight: 500;
    }

    .chat-messages {
      flex: 1;
      overflow-y: auto;
      padding: 18px 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      -webkit-overflow-scrolling: touch;
    }

    .bubble {
      max-width: 78%;
      padding: 12px 16px;
      border-radius: 22px;
      font-size: 15.5px;
      line-height: 1.4;
      animation: bubbleIn 0.35s var(--spring);
      word-wrap: break-word;
    }

    @keyframes bubbleIn {
      from { opacity: 0; transform: scale(0.88) translateY(10px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }

    .bubble.them {
      background: var(--surface-2);
      align-self: flex-start;
      border-bottom-left-radius: 6px;
      backdrop-filter: blur(24px);
      border: 1px solid var(--glass-border);
    }

    .bubble.me {
      background: linear-gradient(135deg, #0a84ff, #0071e3);
      align-self: flex-end;
      border-bottom-right-radius: 6px;
      box-shadow: 0 4px 18px var(--accent-glow);
      color: white;
    }

    .chat-input-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 14px;
      padding-bottom: calc(12px + var(--safe-bottom));
      flex-shrink: 0;
    }

    .chat-input {
      flex: 1;
      height: 44px;
      border-radius: 24px;
      border: 1px solid var(--glass-border);
      background: var(--surface-2);
      color: var(--text);
      padding: 0 18px;
      font-size: 15.5px;
      outline: none;
      transition: border-color 0.25s, box-shadow 0.25s;
      backdrop-filter: blur(24px);
    }

    .chat-input:focus {
      border-color: rgba(10, 132, 255, 0.45);
      box-shadow: 0 0 0 3px rgba(10, 132, 255, 0.14);
    }

    .chat-input::placeholder { color: var(--text-secondary); }

    .chat-send {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: linear-gradient(135deg, #0a84ff, #0071e3);
      border: none;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: transform 0.28s var(--spring), box-shadow 0.25s;
      box-shadow: 0 4px 16px var(--accent-glow);
      flex-shrink: 0;
    }

    .chat-send:active { transform: scale(0.88); }

    /* ========== STORY VIEWER ========== */
    .story-viewer {
      position: absolute;
      inset: 0;
      background: #000;
      z-index: 300;
      display: none;
      flex-direction: column;
      animation: storyOpen 0.4s var(--ease-out);
    }

    .story-viewer.active { display: flex; }

    @keyframes storyOpen {
      from { opacity: 0; transform: scale(0.94); }
      to { opacity: 1; transform: scale(1); }
    }

    .story-progress {
      display: flex;
      gap: 4px;
      padding: 14px 12px 0;
      z-index: 10;
    }

    .story-bar {
      flex: 1;
      height: 2.5px;
      background: rgba(255,255,255,0.28);
      border-radius: 2px;
      overflow: hidden;
    }

    .story-bar-fill {
      height: 100%;
      background: white;
      width: 0%;
      border-radius: 2px;
      box-shadow: 0 0 8px rgba(255,255,255,0.5);
    }

    .story-bar.active .story-bar-fill {
      width: 0%;
      animation: progress var(--story-duration, 5s) linear forwards;
    }

    @keyframes progress {
      from { width: 0%; }
      to { width: 100%; }
    }

    /* Loading spinner para vídeos en stories */
    .story-loading {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #000;
      z-index: 8;
    }
    .story-loading .spinner {
      width: 42px;
      height: 42px;
      border: 3px solid rgba(255,255,255,0.2);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .story-top {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 14px 16px;
      z-index: 10;
    }

    .story-user-avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      object-fit: cover;
      border: 1.5px solid rgba(255,255,255,0.35);
    }

    .story-user-name {
      font-size: 14.5px;
      font-weight: 650;
      flex: 1;
      text-shadow: 0 1px 4px rgba(0,0,0,0.5);
    }

    .story-close {
      width: 40px;
      height: 40px;
      border: none;
      background: transparent;
      color: white;
      font-size: 30px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.25s var(--spring);
      text-shadow: 0 1px 4px rgba(0,0,0,0.5);
    }

    .story-close:active { transform: scale(0.85); }

    .story-media {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .story-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      animation: storyImgIn 0.45s var(--ease-out);
    }

    @keyframes storyImgIn {
      from { opacity: 0; transform: scale(1.05); }
      to { opacity: 1; transform: scale(1); }
    }

    .story-nav-left, .story-nav-right {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 35%;
      z-index: 5;
    }

    .story-nav-left { left: 0; }
    .story-nav-right { right: 0; }

    /* ========== POST MODAL ========== */
    .post-modal {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.94);
      z-index: 250;
      display: none;
      flex-direction: column;
      animation: modalIn 0.4s var(--ease-out);
      backdrop-filter: blur(24px);
    }

    .post-modal.active { display: flex; }

    @keyframes modalIn {
      from { opacity: 0; transform: translateY(40px) scale(0.97); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .post-modal-header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      flex-shrink: 0;
    }

    .post-modal-close {
      width: 40px;
      height: 40px;
      border: none;
      background: transparent;
      color: white;
      font-size: 26px;
      cursor: pointer;
      transition: transform 0.25s var(--spring);
    }

    .post-modal-close:active { transform: scale(0.85); }

    .post-modal-img {
      width: 100%;
      max-height: 58vh;
      object-fit: contain;
      background: #0a0a0a;
      animation: imgReveal 0.5s var(--ease-out);
    }

    @keyframes imgReveal {
      from { opacity: 0; transform: scale(0.96); }
      to { opacity: 1; transform: scale(1); }
    }

    .post-modal-actions {
      display: flex;
      gap: 14px;
      padding: 16px 16px 8px;
    }

    .post-modal-likes {
      padding: 0 16px;
      font-weight: 650;
      font-size: 14.5px;
      letter-spacing: -0.15px;
    }

    .post-modal-caption {
      padding: 8px 16px 24px;
      font-size: 14.5px;
      line-height: 1.45;
    }

    .liked path {
      fill: var(--like);
      stroke: var(--like);
    }

    .liked svg {
      animation: likeBounce 0.45s var(--spring);
    }

    @keyframes likeBounce {
      0% { transform: scale(1); }
      30% { transform: scale(1.3); }
      60% { transform: scale(0.9); }
      100% { transform: scale(1); }
    }

    /* ========== BOTTOM NAV ========== */
    .bottom-nav {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: calc(60px + var(--safe-bottom));
      padding-bottom: var(--safe-bottom);
      display: flex;
      align-items: center;
      justify-content: space-around;
      z-index: 100;
      transition: transform 0.4s var(--ease-out), opacity 0.3s;
    }

    .bottom-nav.hidden {
      transform: translateY(110%);
      opacity: 0;
      pointer-events: none;
    }

    .nav-item {
      width: 58px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: none;
      background: transparent;
      color: var(--text);
      cursor: pointer;
      position: relative;
      transition: transform 0.3s var(--spring);
    }

    .nav-item:active { transform: scale(0.82); }

    .nav-item svg {
      width: 26px;
      height: 26px;
      transition: transform 0.35s var(--spring), opacity 0.2s;
      opacity: 0.85;
    }

    .nav-item.active svg {
      transform: scale(1.12);
      opacity: 1;
    }

    .nav-item .badge {
      position: absolute;
      top: 4px;
      right: 10px;
      min-width: 17px;
      height: 17px;
      background: var(--like);
      border-radius: 9px;
      font-size: 10px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 4px;
      border: 2.5px solid #0c0c0e;
      box-shadow: 0 2px 10px var(--like-glow);
      animation: badgePop 0.5s var(--spring);
    }

    @keyframes badgePop {
      0% { transform: scale(0); }
      60% { transform: scale(1.2); }
      100% { transform: scale(1); }
    }

    /* ========== VIEWS ========== */
    .view {
      display: none;
      flex-direction: column;
      height: 100%;
      position: absolute;
      inset: 0;
      animation: viewIn 0.4s var(--ease-out);
    }

    .view.active { display: flex; }

    @keyframes viewIn {
      from { opacity: 0; transform: translateY(14px) scale(0.985); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 60%;
      gap: 12px;
      color: var(--text-secondary);
      padding: 40px;
      text-align: center;
    }

    .empty-state svg {
      width: 64px;
      height: 64px;
      opacity: 0.35;
      margin-bottom: 8px;
    }

    .empty-state h3 {
      font-size: 18px;
      font-weight: 650;
      color: var(--text);
    }

    .empty-state p {
      font-size: 14px;
      line-height: 1.4;
    }

    .hidden { display: none !important; }

    ::selection { background: rgba(10, 132, 255, 0.35); }

    img { background: #141414; }

    /* Feed video fix */
    .feed-video {
      width: 100%;
      height: 100%;
      border: none;
      background: #000;
    }

    /* ========== ANIMACIONES EXTRA ========== */

    /* Entrada escalonada del grid */
    .post-thumb:nth-child(1) { animation-delay: 0.02s; }
    .post-thumb:nth-child(2) { animation-delay: 0.06s; }
    .post-thumb:nth-child(3) { animation-delay: 0.10s; }
    .post-thumb:nth-child(4) { animation-delay: 0.14s; }
    .post-thumb:nth-child(5) { animation-delay: 0.18s; }
    .post-thumb:nth-child(6) { animation-delay: 0.22s; }
    .post-thumb:nth-child(7) { animation-delay: 0.26s; }
    .post-thumb:nth-child(8) { animation-delay: 0.30s; }
    .post-thumb:nth-child(9) { animation-delay: 0.34s; }
    .post-thumb:nth-child(n+10) { animation-delay: 0.38s; }

    /* Shimmer sutil en el perfil */
    .profile-section {
      position: relative;
      overflow: hidden;
    }
    .profile-section::after {
      content: '';
      position: absolute;
      top: 0; left: -100%;
      width: 55%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.05), transparent);
      animation: shimmer 4.5s ease-in-out infinite;
      pointer-events: none;
      z-index: 2;
    }
    @keyframes shimmer {
      0% { left: -100%; }
      40%, 100% { left: 160%; }
    }

    /* Bounce en botones */
    .btn:active, .chip:active, .nav-item:active, .icon-btn:active {
      transform: scale(0.88);
    }

    /* Anillo de historia propia pulsante */
    .story-ring.own {
      animation: ringPulse 2.5s ease-in-out infinite;
    }
    @keyframes ringPulse {
      0%, 100% { box-shadow: 0 4px 20px rgba(10, 132, 255, 0.4); }
      50% { box-shadow: 0 4px 28px rgba(10, 132, 255, 0.7), 0 0 0 5px rgba(10,132,255,0.12); }
    }

    /* Highlight lift */
    .highlight:hover .highlight-ring {
      transform: translateY(-5px) scale(1.06);
      transition: transform 0.35s var(--spring), border-color 0.25s, box-shadow 0.25s;
    }

    /* Like bounce mejorado */
    @keyframes likeBounce {
      0% { transform: scale(1); }
      20% { transform: scale(1.45); }
      40% { transform: scale(0.85); }
      60% { transform: scale(1.18); }
      80% { transform: scale(0.95); }
      100% { transform: scale(1); }
    }

    /* Online dot pulse */
    .online-dot {
      animation: onlinePulse 1.8s ease-in-out infinite;
    }
    @keyframes onlinePulse {
      0%, 100% { opacity: 1; box-shadow: 0 0 8px var(--like-glow); }
      50% { opacity: 0.55; box-shadow: 0 0 16px var(--like-glow); }
    }

    /* Chat bubbles desde lados */
    .bubble.me {
      animation: bubbleMe 0.4s var(--spring);
    }
    .bubble.them {
      animation: bubbleThem 0.4s var(--spring);
    }
    @keyframes bubbleMe {
      from { opacity: 0; transform: translateX(28px) scale(0.88); }
      to { opacity: 1; transform: translateX(0) scale(1); }
    }
    @keyframes bubbleThem {
      from { opacity: 0; transform: translateX(-28px) scale(0.88); }
      to { opacity: 1; transform: translateX(0) scale(1); }
    }

    /* Stats números pop */
    .stat-num {
      animation: numPop 0.55s var(--spring) both;
    }
    .stat:nth-child(1) .stat-num { animation-delay: 0.08s; }
    .stat:nth-child(2) .stat-num { animation-delay: 0.16s; }
    .stat:nth-child(3) .stat-num { animation-delay: 0.24s; }
    @keyframes numPop {
      from { opacity: 0; transform: scale(0.4) translateY(10px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }

    /* Nav activo con glow */
    .nav-item.active svg {
      filter: drop-shadow(0 0 7px rgba(255,255,255,0.4));
      transition: transform 0.35s var(--spring), opacity 0.2s, filter 0.3s;
    }

    /* Imágenes fade in */
    .post-thumb img, .feed-img, .profile-pic, .highlight-img, .story-avatar {
      animation: imgFade 0.55s var(--ease-out) both;
    }
    @keyframes imgFade {
      from { opacity: 0; transform: scale(1.05); }
      to { opacity: 1; transform: scale(1); }
    }

    /* Mensajes lista entrada */
    .msg-item {
      animation: msgIn 0.4s var(--ease-out) both;
    }
    .msg-item:nth-child(1) { animation-delay: 0.05s; }
    .msg-item:nth-child(2) { animation-delay: 0.1s; }
    .msg-item:nth-child(3) { animation-delay: 0.15s; }
    @keyframes msgIn {
      from { opacity: 0; transform: translateX(-16px); }
      to { opacity: 1; transform: translateX(0); }
    }

    /* ========== LOGIN SCREEN ========== */
    .login-screen {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      background: radial-gradient(ellipse at 50% 20%, #1a1a2e 0%, #050505 70%);
      animation: loginFade 0.5s ease both;
    }
    .login-screen.hide {
      animation: loginOut 0.5s var(--ease-out) forwards;
      pointer-events: none;
    }
    @keyframes loginFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes loginOut {
      to { opacity: 0; transform: scale(1.05); }
    }
    .login-card {
      width: 90%;
      max-width: 360px;
      padding: 36px 28px 32px;
      border-radius: 24px;
      background: rgba(22, 22, 26, 0.85);
      backdrop-filter: blur(40px) saturate(180%);
      -webkit-backdrop-filter: blur(40px) saturate(180%);
      border: 1px solid rgba(255,255,255,0.12);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.1),
        0 30px 80px rgba(0,0,0,0.5);
      text-align: center;
      animation: cardUp 0.6s var(--spring) both;
    }
    @keyframes cardUp {
      from { opacity: 0; transform: translateY(30px) scale(0.95); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .login-logo {
      font-size: 32px;
      font-weight: 800;
      letter-spacing: -1.5px;
      background: linear-gradient(135deg, #fff 0%, #c8c8d0 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 6px;
    }
    .login-sub {
      font-size: 13px;
      color: var(--text-secondary);
      margin-bottom: 28px;
    }
    .login-field {
      width: 100%;
      height: 48px;
      border-radius: 14px;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.06);
      color: var(--text);
      padding: 0 16px;
      font-size: 15px;
      outline: none;
      margin-bottom: 12px;
      transition: border-color 0.25s, box-shadow 0.25s;
    }
    .login-field:focus {
      border-color: rgba(10, 132, 255, 0.5);
      box-shadow: 0 0 0 3px rgba(10, 132, 255, 0.15);
    }
    .login-field::placeholder { color: var(--text-tertiary); }
    .login-btn {
      width: 100%;
      height: 48px;
      border-radius: 14px;
      border: none;
      background: linear-gradient(135deg, #0a84ff, #0071e3);
      color: white;
      font-size: 15.5px;
      font-weight: 650;
      cursor: pointer;
      margin-top: 8px;
      box-shadow: 0 6px 24px rgba(10, 132, 255, 0.4);
      transition: transform 0.28s var(--spring), box-shadow 0.25s;
    }
    .login-btn:active { transform: scale(0.96); }
    .login-error {
      color: var(--like);
      font-size: 13px;
      margin-top: 12px;
      min-height: 18px;
      opacity: 0;
      transition: opacity 0.3s;
    }
    .login-error.show { opacity: 1; }
    .login-hint {
      margin-top: 18px;
      font-size: 12px;
      color: var(--text-tertiary);
    }

    /* Music control */
    .music-btn {
      position: absolute;
      top: 12px;
      right: 14px;
      z-index: 200;
      width: 36px;
      height: 36px;
