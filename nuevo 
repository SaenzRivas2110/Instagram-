      }
    }

    function prevStory() {
      if (currentStory > 0) {
        openStory(currentStory - 1);
      }
    }

    function closeStory() {
      clearTimeout(storyTimer);
      document.getElementById('story-viewer').classList.remove('active');
      // Limpiar iframe para que no siga cargando en segundo plano
      const mediaEl = document.getElementById('story-media-content');
      if (mediaEl) mediaEl.innerHTML = '';
    }

    function renderMessages() {
      const list = document.getElementById('messages-list');
      list.innerHTML = messagesData.map(m => `
        <div class="msg-item" onclick="openChat('${m.name}', '${m.avatar}')">
          <img class="msg-avatar" src="${m.avatar}" alt="" onerror="this.src='${fallback('msg', 120)}'">
          <div class="msg-info">
            <div class="msg-top">
              <span class="msg-name">${m.name}</span>
              <span class="msg-time">${m.time}</span>
            </div>
            <div class="msg-preview ${m.unread ? 'unread' : ''}">${m.preview}</div>
          </div>
          ${m.unread ? '<div class="msg-dot"></div>' : ''}
        </div>
      `).join('');
    }

    function openChat(name, avatar) {
      document.getElementById('chat-name').textContent = name;
      document.getElementById('chat-avatar').src = avatar;

      const messages = chatHistory[name] || [
        { from: 'them', text: 'Hola ❤️' },
        { from: 'me', text: '¡Hola mi amor!' },
      ];

      const container = document.getElementById('chat-messages');
      container.innerHTML = messages.map(m => `
        <div class="bubble ${m.from}">${m.text}</div>
      `).join('');

      container.scrollTop = container.scrollHeight;
      switchView('chat');
    }

    function sendMessage() {
      const input = document.getElementById('chat-input');
      const text = input.value.trim();
      if (!text) return;

      const container = document.getElementById('chat-messages');
      const bubble = document.createElement('div');
      bubble.className = 'bubble me';
      bubble.textContent = text;
      container.appendChild(bubble);
      container.scrollTop = container.scrollHeight;
      input.value = '';

      const replies = [
        'Te amo ❤️',
        'Eres lo mejor de mi día 💕',
        'Siempre contigo 🥰',
        'Me haces muy feliz 😍',
        '¿Cuándo nos vemos? 💖',
        'Pensando en ti ahora mismo…',
        'Eres mi persona favorita ❤️'
      ];
      setTimeout(() => {
        const reply = document.createElement('div');
        reply.className = 'bubble them';
        reply.textContent = replies[Math.floor(Math.random() * replies.length)];
        container.appendChild(reply);
        container.scrollTop = container.scrollHeight;
      }, 900 + Math.random() * 800);
    }

    document.addEventListener('keydown', e => {
      if (e.key === 'Enter' && document.getElementById('view-chat').classList.contains('active')) {
        sendMessage();
      }
      if (e.key === 'Escape') {
        closeStory();
        closePost();
        closeModals();
      }
    });

    // Extra features
    function openEditProfile() {
      const current = document.querySelector('.username-title')?.textContent || 'rivas_saenz';
      const name = prompt('Nuevo nombre de usuario:', current);
      if (name && name.trim()) {
        document.querySelectorAll('.username-title').forEach(el => el.textContent = name.trim());
        alert('✅ Usuario actualizado');
      }
    }

    function shareProfile() {
      if (navigator.share) {
        navigator.share({
          title: 'Mi perfil de Instagram',
          text: 'Mira mi perfil estilo Instagram Liquid Glass',
          url: window.location.href
        }).catch(() => {});
      } else {
        navigator.clipboard.writeText(window.location.href);
        alert('🔗 Enlace copiado al portapapeles');
      }
    }

    function openCreatePost() {
      const caption = prompt('Escribe el caption de tu nueva publicación:');
      if (caption && caption.trim()) {
        const randomImg = postsData[Math.floor(Math.random() * postsData.length)].src || postsData[0].src;
        postsData.unshift({
          type: 'image',
          src: randomImg,
          likes: Math.floor(Math.random() * 500) + 50,
          caption: caption.trim(),
          seed: 'new' + Date.now()
        });
        renderPostsGrid();
        renderFeed();
        switchView('profile');
        alert('✅ Publicación creada (simulada)');
      }
    }

    function closeModals() {
      document.querySelectorAll('.post-modal, .story-viewer').forEach(m => m.classList.remove('active'));
    }

    function toggleLike(btn) {
      btn.classList.toggle('liked');
      const svg = btn.querySelector('svg');
      if (btn.classList.contains('liked')) {
        svg.setAttribute('fill', '#ff375f');
        svg.setAttribute('stroke', '#ff375f');
      } else {
        svg.setAttribute('fill', 'none');
        svg.setAttribute('stroke', 'currentColor');
      }
    }

    init();
  </script>
</body>
</html>
